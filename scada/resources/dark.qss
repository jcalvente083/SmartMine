/* =============================================================================
   SmartMine SCADA: modo oscuro industrial
   ============================================================================= */

/* --- Base ------------------------------------------------------------------ */
QWidget {
    background-color: #1e1f22;
    color: #d4d4d4;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow,
QStatusBar {
    background-color: #18191b;
}

/* --- Pestañas -------------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #3a3c40;
    top: -1px;
}

QTabBar::tab {
    background-color: #2a2c30;
    color: #a0a0a0;
    padding: 8px 20px;
    border: 1px solid #3a3c40;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #1e1f22;
    color: #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #33353a;
}

/* --- Barra de estado ------------------------------------------------------- */
QStatusBar {
    border-top: 1px solid #3a3c40;
}

QStatusBar QLabel {
    padding: 2px 8px;
}

/* --- Indicador de conexión --------------------------------------------------
   Estado normal: discreto. Estado anómalo: llamativo (principio ISA-101). */
QLabel#connectionIndicator[connected="true"] {
    color: #8fbf8f;
}

QLabel#connectionIndicator[connected="false"] {
    color: #ffffff;
    background-color: #b3261e;
    font-weight: bold;
}

/* --- Parada de emergencia ---------------------------------------------------
   La única pieza en rojo permanente: debe encontrarse sin buscarla.
   Rojo sobre amarillo, como las setas físicas (ISO 13850). */
QPushButton#emergencyStopButton {
    background-color: #b3261e;
    color: #ffffff;
    font-weight: bold;
    font-size: 12pt;
    padding: 10px 24px;
    border: 2px solid #ffcc00;
    border-radius: 6px;
}

QPushButton#emergencyStopButton:hover {
    background-color: #d32f2f;
}

QPushButton#emergencyStopButton:pressed {
    background-color: #8e1c16;
}

QLabel#emergencyBanner {
    background-color: #b3261e;
    color: #ffffff;
    font-weight: bold;
    padding: 8px;
}
