# =============================================================================
#  SmartMine — .gitignore
# =============================================================================

# --- Entornos -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Modelos de visión artificial (pesados; se descargan, no se versionan) ---
*.pt
*.onnx
*.engine

# --- C++ / Qt / CMake --------------------------------------------------------
build/
build-*/
cmake-build-*/
out/
CMakeLists.txt.user*
*.pro.user*
CMakeCache.txt
CMakeFiles/
compile_commands.json
moc_*.cpp
qrc_*.cpp
ui_*.h
*.o
*.obj
*.so
*.dll
*.dylib
*.exe

# --- Datos y logs locales ----------------------------------------------------
*.log
logs/
data/

# --- IDEs y editores ---------------------------------------------------------
.vscode/
.idea/
*.swp
*~

# --- Sistema operativo -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini